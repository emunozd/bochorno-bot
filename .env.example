# ── LLM — local server (default, no key needed) ───────────────────────────
LLM_BACKEND=openai
LLM_BASE_URL=http://localhost:11434/v1   # Ollama default — change for LM Studio, vLLM, etc.
LLM_API_KEY=none
LLM_MODEL=llama3.2                       # any model you have pulled locally

# ── LLM — alternatives (comment out the local block above first) ──────────

# Groq (fast, generous free tier)
# LLM_BACKEND=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your_key_here
# LLM_MODEL=llama-3.3-70b-versatile

# OpenAI
# LLM_BACKEND=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your_key_here
# LLM_MODEL=gpt-4o-mini

# Anthropic Claude
# LLM_BACKEND=anthropic
# LLM_API_KEY=sk-ant-your-key-here
# LLM_MODEL=claude-sonnet-4-20250514

# ── Optional: secondary weather source ────────────────────────────────────
# OWM_API_KEY=your_openweathermap_key   # free tier: 1000 calls/day
# (Open-Meteo is the primary source and requires NO key)

# ── Optional: Telegram notifications ──────────────────────────────────────
# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_LINK_SECRET=your-seed-phrase-here

# ── Optional: live trading on Polymarket ──────────────────────────────────
# POLY_PRIVATE_KEY=0x_your_polygon_wallet_private_key
# POLY_FUNDER_ADDRESS=0x_your_wallet_address_holding_usdc

# ── Optional: tune thresholds ─────────────────────────────────────────────
# WCS_MIN=65
# EDGE_MIN=0.08
# SIGMA_MAX=3.0
# STOP_LOSS_PCT=0.35
# TAKE_PROFIT_PCT=0.50
# KELLY_FRACTION=0.25
# CAPITAL_INITIAL=500.0
# BOT_DB=bot.db
# CLIMATE_HIST_DAYS=730
